POSTGRES_PASSWORD=change-me
# 0 — только для локальной разработки по http. В проде за TLS не задавать (по умолчанию 1).
COOKIE_SECURE=0
AIRTABLE_TOKEN=

# Почта для «Отправить запись» (пусто — отправка выключена).
# 587 + STARTTLS — обычный ящик; 465 — SMTP_SSL=1; внутренний релей на 25 без шифрования — SMTP_STARTTLS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0
SMTP_STARTTLS=1

# Снимки (сервис backup): каталог на хосте (на NAS — другой диск), час автоснимка (по BACKUP_TZ), сколько дней хранить
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_DAYS=365
BACKUP_TZ=Asia/Tomsk
# 1 — копировать и вложения (19+ ГБ, одна копия, докопируются новые). Только если BACKUP_DIR на ДРУГОМ диске
BACKUP_FILES=0
# Адрес веба для «Открыть снимок» (пусто — тот же хост, порт 5201)
SNAPSHOT_URL=
