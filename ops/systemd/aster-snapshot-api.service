[Unit]
Description=Aster API — открытый снимок (только чтение)
After=postgresql.service
Requires=postgresql.service

[Service]
User=@USER@
WorkingDirectory=@DIR@/api
EnvironmentFile=@DIR@/.env
Environment=SNAPSHOT_MODE=1 AUTOMATIONS_WORKER=0
# база снимка bd_snapshot; ждёт, пока backup её откроет
ExecStart=/bin/sh -c 'export DATABASE_URL="$SNAPSHOT_DATABASE_URL"; @VENV@/bin/python -m app.snapshot_wait && @VENV@/bin/alembic upgrade head && exec @VENV@/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
