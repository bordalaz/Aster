# .env сервера без Docker (docs/deploy.md): cp ops/server.env.example .env
# Пароль базы — длинный, свой (не как на тестовом стенде). Тот же пароль — в трёх адресах ниже.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://bd:change-me@localhost/bd
SNAPSHOT_DATABASE_URL=postgresql+psycopg://bd:change-me@localhost/bd_snapshot
OPS_DATABASE_URL=postgresql+psycopg://bd:change-me@localhost/bd_ops
PGHOST=localhost

# Адрес, по которому заходят: IP в локальной сети или домен (без https://)
ASTER_HOST=192.168.1.57
# internal — свой сертификат Caddy (локалка); e-mail — сертификат Let's Encrypt (домен)
ASTER_TLS=internal
# адрес клиента — из X-Forwarded-For от Caddy (иначе все «из офиса» и один лимит входа на всех)
TRUSTED_PROXIES=127.0.0.1/32
# R7: не-админы входят только из этих сетей (пусто — частные сети)
OFFICE_NETS=
# Адрес веба для «Открыть снимок» (пусто — тот же хост, порт 5201)
SNAPSHOT_URL=

# вложения
ATTACH_ROOT=/home/aster-su/aster/data/snapshot
# Снимки: каталог (USB-диск — /mnt/usb/aster), час автоснимка (по BACKUP_TZ), сколько дней хранить
BACKUP_DIR=/home/aster-su/aster/backups
BACKUP_HOUR=3
BACKUP_DAYS=365
TZ=Asia/Tomsk
# 1 — копировать и вложения (только если BACKUP_DIR на другом диске)
BACKUP_FILES=0
# облако для копии снимков (rclone remote)
OFFSITE_REMOTE=aster:

AIRTABLE_TOKEN=
# Почта для «Отправить запись» (пусто — выключена)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0
SMTP_STARTTLS=1
